# ==============================================================================
# TENDERHUB SRI LANKA — PRODUCTION DOCKER ENVIRONMENT TEMPLATE
# Copy to .env on the production host (chmod 600 .env)
# Generate secrets with: openssl rand -hex 32
# ==============================================================================

# Core Application URL
APP_BASE_URL=https://tenderhub.lk

# MySQL 8 Production Database (strict caching_sha2_password, utf8mb4_unicode_ci)
MYSQL_ROOT_PASSWORD=generate_strong_root_password_at_least_32_chars
MYSQL_DATABASE=tenderhub_prod
MYSQL_USER=tenderhub_user
MYSQL_PASSWORD=generate_strong_db_password_at_least_32_chars

# Authentication & Key Derivation (>=32 bytes required, NEVER commit or reuse)
# JWT_SECRET is shared identically between CodeIgniter 4 API and Next.js BFF
JWT_SECRET=generate_strong_jwt_secret_at_least_32_chars_random
SESSION_SECRET=generate_strong_session_secret_at_least_32_chars_random
FILES_SIGNING_KEY=generate_strong_files_signing_key_at_least_32_chars_random
INGEST_SECRET_KEY=generate_strong_crawler_ingest_key_random

# Security Headers & Rate Limits
CSP_ENFORCE=1
FREE_VIEW_LIMIT=5

# Optional External Integration Secrets (leave empty if not yet provisioned)
PAYHERE_MODE=live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENTRY_DSN=
